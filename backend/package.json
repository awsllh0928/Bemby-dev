{
  "name": "bemby-backend",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cloakbrowser": "^0.5.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "imapflow": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "mailparser": "^3.9.14",
    "mongodb": "^6.10.0",
    "playwright-core": "^1.62.0",
    "socks": "^2.8.9",
    "svg-captcha": "^1.4.0",
    "telegram": "^2.26.22",
    "undici": "^8.5.0",
    "ws": "^8.21.0"
  },
  "//optionalDependencies": [
    "better-sqlite3 holds no Bemby data any more -- MongoDB does. It survives for one thing:",
    "reading a pre-MongoDB data/bemby.db during the import offered in Settings (db/mongo/migrate.ts).",
    "Optional so that a native build that fails -- no compiler, or no prebuilt binary for the",
    "Node version -- costs that one button instead of the whole install. migrate.ts reports it",
    "plainly when the module is missing."
  ],
  "optionalDependencies": {
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/luxon": "^3.4.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "mongodb-memory-server": "^11.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "argon2": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "utf-8-validate@5.0.10": true,
    "better-sqlite3@9.6.0": true,
    "bufferutil@4.1.0": true,
    "es5-ext@0.10.64": true
  }
}
